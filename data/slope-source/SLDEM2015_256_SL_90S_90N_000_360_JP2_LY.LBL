PDS_VERSION_ID            = "PDS3"

/*** This label describes a compressed image file, its corresponding XML    */
/*** file, and map projection information.                                  */
/*** The files described have the same name as this label but different     */
/*** extensions. They are:                                                  */
/***    .JP2 - A compressed image file corresponding to the uncompressed IMG*/
/***           file, stored with JPEG2000 compression                       */
/***    .XML - An auxiliary text file in XML, provided to aid display of    */
/***           the JPEG2000 image with certain image processing software    */
/*** The map projection information includes parameters that are specific   */
/*** to this image. They are intended to be used with the general map       */
/*** projection descriptions in the file indicated by the keyword           */
/*** ^DATA_SET_MAP_PROJECTION. That file is found in the CATALOG directory  */
/*** of this archive.                                                       */

/*** GENERAL DATA DESCRIPTION PARAMETERS ***/
PRODUCT_VERSION_ID        = "V1.0"
DATA_SET_ID               = "LRO-L-LOLA-4-GDR-V1.0"
PRODUCT_ID                = "SLDEM2015_256_SL_90S_90N_000_360"
INSTRUMENT_HOST_NAME      = "LUNAR RECONNAISSANCE ORBITER"
INSTRUMENT_NAME           = "LUNAR ORBITER LASER ALTIMETER"
INSTRUMENT_ID             = "LOLA"
MISSION_PHASE_NAME        = {"COMMISSIONING","NOMINAL MISSION","SCIENCE
                            MISSION","EXTENDED SCIENCE MISSION"}
TARGET_NAME               = MOON
START_TIME                = 2009-07-13T17:33:17.246
STOP_TIME                 = 2013-07-18T00:00:00
PRODUCT_CREATION_TIME     = 2018-03-15
PRODUCER_ID               = LRO_LOLA_TEAM
PRODUCER_FULL_NAME        = "DAVID E. SMITH"
PRODUCER_INSTITUTION_NAME = "GODDARD SPACE FLIGHT CENTER"
DESCRIPTION               = "This data product is an slope map of the Moon 
   at a resolution of 256 pix/deg by 256 pix/deg, made using the SLDEM 
   topographic products between 60S and 60N, and LOLA data outside that 
   geographic range.  

   This label describes three objects.  The first is a JP2 file of the 
   corresponding uncompressed .IMG file.  A lossy jpeg 2000 compression 
   is used to render the image.  The second is the uncompressed source file.
   The third is an auxiliary XML file that contains extensible markup 
   language that is interpreted by GDAL readers (www.gdal.org).
"

OBJECT                    = COMPRESSED_FILE
FILE_NAME                 = "SLDEM2015_256_SL_90S_90N_000_360_LY.JP2"
  RECORD_TYPE             = UNDEFINED
  FILE_RECORDS            = UNK
  ENCODING_TYPE           = "JP2"
  INTERCHANGE_FORMAT      = BINARY
  SCALING_FACTOR          = 0.01
  OFFSET                  = 0
  UNCOMPRESSED_FILE_NAME  = "SLDEM2015_256_SL_90S_90N_000_360.IMG"
  REQUIRED_STORAGE_BYTES  = "530842243"
  ^DESCRIPTION            = "JP2INFO.TXT"
END_OBJECT                = COMPRESSED_FILE

OBJECT                    = UNCOMPRESSED_FILE
FILE_NAME                 = "SLDEM2015_256_SL_90S_90N_000_360.IMG"
RECORD_TYPE               = FIXED_LENGTH
FILE_RECORDS              = 46080
RECORD_BYTES              = 184320
^IMAGE                    = "SLDEM2015_256_SL_90S_90N_000_360.IMG"
  OBJECT                  = IMAGE
    NAME                  = SLOPE
    DESCRIPTION           = "Each sample represents slope and is generated 
    using LOLA data and Kaguya's SELENE Terrain Camera data as refined by 
    the LOLA and TC teams, respectively."
    LINES                 = 46080
    LINE_SAMPLES          = 92160
    MAXIMUM               = 89
    MINIMUM               = 0
    SAMPLE_TYPE           = PC_REAL
    SAMPLE_BITS           = 32
  END_OBJECT              = IMAGE
END_OBJECT                = UNCOMPRESSED_FILE

OBJECT                    = AUX_FILE
  FILE_NAME               = "SLDEM2015_256_SL_90S_90N_000_360_AUX.XML"
  RECORD_TYPE             = STREAM
  FILE_RECORDS            = UNK
  DESCRIPTION             = "This is an auxiliary file accompanying
     the JPEG2000 file. It contains metadata in XML format that
     is useful for displaying the image using a GDAL supported tool."
END_OBJECT                = AUX_FILE
OBJECT                    = IMAGE_MAP_PROJECTION
 ^DATA_SET_MAP_PROJECTION     = "DSMAP.CAT"
 MAP_PROJECTION_TYPE          = "SIMPLE CYLINDRICAL"
 MAP_RESOLUTION               = 256 <pix/deg>
 A_AXIS_RADIUS                = 1737.4 <km>
 B_AXIS_RADIUS                = 1737.4 <km>
 C_AXIS_RADIUS                = 1737.4 <km>
 FIRST_STANDARD_PARALLEL      = 'N/A'
 SECOND_STANDARD_PARALLEL     = 'N/A'
 POSITIVE_LONGITUDE_DIRECTION = "EAST"
 CENTER_LATITUDE              = 0. <deg>
 CENTER_LONGITUDE             = 0. <deg>
 REFERENCE_LATITUDE           = 'N/A'
 REFERENCE_LONGITUDE          = 'N/A'
 LINE_FIRST_PIXEL             = 1
 LINE_LAST_PIXEL              = 46080
 SAMPLE_FIRST_PIXEL           = 1
 SAMPLE_LAST_PIXEL            = 92160
 MAP_PROJECTION_ROTATION      = 0.0
 MAP_SCALE                    = 0.1184505876 <km/pix>
 MAXIMUM_LATITUDE             = 90 <deg>
 MINIMUM_LATITUDE             = -90 <deg>
 WESTERNMOST_LONGITUDE        = -180 <deg>
 EASTERNMOST_LONGITUDE        = 180 <deg>
 LINE_PROJECTION_OFFSET       = 23039.5 <pix>
 SAMPLE_PROJECTION_OFFSET     = 46079.5 <pix>
 COORDINATE_SYSTEM_TYPE       = "BODY-FIXED ROTATING"
 COORDINATE_SYSTEM_NAME       = "MEAN EARTH/POLAR AXIS OF DE421"
END_OBJECT                    = IMAGE_MAP_PROJECTION

END
