# Online terrain and JPL Horizons. No API key is required.
LUNARPILOT_PORT=4173
# Timeout for one DEM byte-range request, milliseconds (1000–120000).
LUNARPILOT_TERRAIN_TIMEOUT_MS=30000
# Optional contact URL/email for JPL requests:
LUNARPILOT_CONTACT=https://github.com/fenzit/Lunar-Landing-Site-Navigator
